# AI Provider Configuration
# Options: deepseek, openai, local
AI_PROVIDER=deepseek

# API Key (Required for DeepSeek/OpenAI)
AI_API_KEY=your_api_key_here

# Base URL (Optional, for Local LLM or custom endpoints)
# DeepSeek: https://api.deepseek.com/v1
# Local (e.g. LM Studio): http://localhost:1234/v1
AI_BASE_URL=https://api.deepseek.com/v1

# Model Name
# DeepSeek: deepseek-chat, deepseek-coder
# OpenAI: gpt-4, gpt-3.5-turbo
# Local: model-identifier
AI_MODEL_NAME=deepseek-chat

# Rows used for context in AI prompt (keep small to reduce token cost)
AI_CONTEXT_ROWS=10

# Rows returned to frontend preview after upload
UPLOAD_PREVIEW_ROWS=10

# Upload security
# Max upload size in bytes (default 20MB)
UPLOAD_MAX_BYTES=20971520
# Allowed extensions (comma-separated)
UPLOAD_ALLOWED_EXT=.csv,.xls,.xlsx

# Database module
# If empty, a local key file will be generated under backend/data/.db_key
DB_ENCRYPTION_KEY=
DB_QUERY_PREVIEW_ROWS=1000
DB_QUERY_SAVE_MAX_ROWS=100000
